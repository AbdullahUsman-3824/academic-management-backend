model AssessmentCategory {
  name         String
  weightage    Decimal      @db.Decimal(5, 2)
  displayOrder Int          @default(0) @map("display_order")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime?    @updatedAt @map("updated_at")
  id           String       @id @default(uuid()) @db.Uuid
  assessments  Assessment[]

  @@map("assessment_categories")
}

model Assessment {
  title                String
  totalMarks           Decimal            @map("total_marks") @db.Decimal(6, 2)
  assessmentDate       DateTime?          @map("assessment_date") @db.Date
  status               String             @default("draft")
  submittedAt          DateTime?          @map("submitted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @updatedAt @map("updated_at")
  id                   String             @id @default(uuid()) @db.Uuid
  courseAllocationId   String             @map("course_allocation_id") @db.Uuid
  assessmentCategoryId String             @map("assessment_category_id") @db.Uuid
  createdBy            String             @map("created_by") @db.Uuid
  assessmentCategory   AssessmentCategory @relation(fields: [assessmentCategoryId], references: [id])
  courseAllocation     CourseAllocation   @relation(fields: [courseAllocationId], references: [id])
  creator              Faculty            @relation("AssessmentCreatedBy", fields: [createdBy], references: [id])
  studentMarks         StudentMark[]

  @@map("assessments")
}

model StudentMark {
  marksObtained Decimal    @map("marks_obtained") @db.Decimal(6, 2)
  remarks       String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime?  @updatedAt @map("updated_at")
  id            String     @id @default(uuid()) @db.Uuid
  assessmentId  String     @map("assessment_id") @db.Uuid
  studentId     String     @map("student_id") @db.Uuid
  enteredBy     String?    @map("entered_by") @db.Uuid
  updatedBy     String?    @map("updated_by") @db.Uuid
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  enteredByFac  Faculty?   @relation("MarkEnteredBy", fields: [enteredBy], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])
  updatedByFac  Faculty?   @relation("MarkUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([assessmentId, studentId])
  @@map("student_marks")
}

model StudentCourseResult {
  totalPercentage    Decimal          @map("total_percentage") @db.Decimal(5, 2)
  grade              String?
  gradePoint         Decimal?         @map("grade_point") @db.Decimal(3, 2)
  creditHours        Int              @map("credit_hours")
  status             String           @default("draft")
  isReappear         Boolean          @default(false) @map("is_reappear")
  calculatedAt       DateTime?        @map("calculated_at")
  finalizedAt        DateTime?        @map("finalized_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime?        @updatedAt @map("updated_at")
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  courseEnrollmentId String           @map("course_enrollment_id") @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  academicSessionId  String           @map("academic_session_id") @db.Uuid
  finalizedBy        String?          @map("finalized_by") @db.Uuid
  academicSession    AcademicSession  @relation(fields: [academicSessionId], references: [id])
  courseEnrollment   CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id])
  course             Course           @relation(fields: [courseId], references: [id])
  finalizedByUser    User?            @relation("ResultFinalizedBy", fields: [finalizedBy], references: [id])
  student            Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseEnrollmentId])
  @@map("student_course_results")
}

model GradeScale {
  gradeLetter   String  @map("grade_letter")
  minPercentage Decimal @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal @map("max_percentage") @db.Decimal(5, 2)
  gradePoint    Decimal @map("grade_point") @db.Decimal(3, 2)
  displayOrder  Int     @default(0) @map("display_order")
  id            String  @id @default(uuid()) @db.Uuid

  @@map("grade_scales")
}
