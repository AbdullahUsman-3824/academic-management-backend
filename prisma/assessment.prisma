// Assessment & Grading Models

model AssessmentCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  weightage    Decimal   @db.Decimal(5, 2)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  assessments Assessment[]

  @@map("assessment_categories")
}

model Assessment {
  id                   String    @id @default(uuid()) @db.Uuid
  courseAllocationId   String    @map("course_allocation_id") @db.Uuid
  assessmentCategoryId String    @map("assessment_category_id") @db.Uuid
  title                String
  totalMarks           Decimal   @map("total_marks") @db.Decimal(6, 2)
  assessmentDate       DateTime? @map("assessment_date") @db.Date
  status               String    @default("draft")
  createdBy            String    @map("created_by") @db.Uuid
  submittedAt          DateTime? @map("submitted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @map("updated_at")

  courseAllocation   CourseAllocation   @relation(fields: [courseAllocationId], references: [id])
  assessmentCategory AssessmentCategory @relation(fields: [assessmentCategoryId], references: [id])
  createdByFaculty   Faculty            @relation(fields: [createdBy], references: [id])
  studentMarks       StudentMark[]

  @@map("assessments")
}

// Marks belong to an enrollment (one attempt), not directly to a student.
// Service rule: enrollment.allocationId must equal assessment.courseAllocationId.
model StudentMark {
  id                 String    @id @default(uuid()) @db.Uuid
  assessmentId       String    @map("assessment_id") @db.Uuid
  courseEnrollmentId String    @map("course_enrollment_id") @db.Uuid
  marksObtained      Decimal   @map("marks_obtained") @db.Decimal(6, 2)
  remarks            String?
  enteredBy          String?   @map("entered_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @map("updated_at")

  assessment       Assessment       @relation(fields: [assessmentId], references: [id])
  courseEnrollment CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id])
  enteredByFaculty Faculty?         @relation("EnteredBy", fields: [enteredBy], references: [id])
  updatedByFaculty Faculty?         @relation("UpdatedBy", fields: [updatedBy], references: [id])

  @@unique([assessmentId, courseEnrollmentId])
  @@index([courseEnrollmentId])
  @@map("student_marks")
}
