// =====================================================
// MODULE 5: ASSESSMENT & RESULT MANAGEMENT
// =====================================================

model AssessmentCategory {
  id           Int       @id @default(autoincrement())
  name         String // Quiz | Assignment | Presentation | Attendance | Mid-term | Final | Others
  weightage    Decimal   @db.Decimal(5, 2) // Percentage weight e.g. 10, 20, 30, 50
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  assessments Assessment[]

  @@map("assessment_categories")
}

model Assessment {
  id                   Int       @id @default(autoincrement())
  courseAllocationId   Int       @map("course_allocation_id")
  assessmentCategoryId Int       @map("assessment_category_id")
  title                String // e.g. Quiz 1, Assignment 2, Mid-term
  totalMarks           Decimal   @map("total_marks") @db.Decimal(6, 2)
  assessmentDate       DateTime? @map("assessment_date") @db.Date
  status               String    @default("draft") // draft | submitted
  createdBy            Int       @map("created_by") // faculty who created it
  submittedAt          DateTime? @map("submitted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  courseAllocation   CourseAllocation   @relation(fields: [courseAllocationId], references: [id])
  assessmentCategory AssessmentCategory @relation(fields: [assessmentCategoryId], references: [id])
  creator            Faculty            @relation("AssessmentCreatedBy", fields: [createdBy], references: [id])
  studentMarks       StudentMark[]

  @@map("assessments")
}

model StudentMark {
  id            Int       @id @default(autoincrement())
  assessmentId  Int       @map("assessment_id")
  studentId     Int       @map("student_id")
  marksObtained Decimal   @map("marks_obtained") @db.Decimal(6, 2)
  remarks       String?
  enteredBy     Int?      @map("entered_by") // faculty who entered marks
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])
  enteredByFac Faculty?   @relation("MarkEnteredBy", fields: [enteredBy], references: [id])
  updatedByFac Faculty?   @relation("MarkUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([assessmentId, studentId])
  @@map("student_marks")
}

model StudentCourseResult {
  id                 Int       @id @default(autoincrement())
  studentId          Int       @map("student_id")
  courseEnrollmentId Int       @map("course_enrollment_id")
  courseId           Int       @map("course_id")
  academicSessionId  Int       @map("academic_session_id")

  totalPercentage    Decimal   @map("total_percentage") @db.Decimal(5, 2) // Final percentage after applying weightages
  grade              String? // A+, A, B+, B, C, D, F
  gradePoint         Decimal?  @map("grade_point") @db.Decimal(3, 2) // e.g. 4.0, 3.7, 3.0, 0.0
  creditHours        Int       @map("credit_hours")

  status             String    @default("draft") // draft | finalized
  isReappear         Boolean   @default(false) @map("is_reappear")

  calculatedAt       DateTime? @map("calculated_at")
  finalizedAt        DateTime? @map("finalized_at")
  finalizedBy        Int?      @map("finalized_by") // Admin who finalized the result

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  student          Student          @relation(fields: [studentId], references: [id])
  courseEnrollment CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id])
  course           Course           @relation(fields: [courseId], references: [id])
  academicSession  AcademicSession  @relation(fields: [academicSessionId], references: [id])
  finalizedByUser  User?            @relation("ResultFinalizedBy", fields: [finalizedBy], references: [id])

  @@unique([studentId, courseEnrollmentId])
  @@map("student_course_results")
}

model GradeScale {
  id            Int     @id @default(autoincrement())
  gradeLetter   String  @map("grade_letter") // A+, A, B+, B, C, D, F
  minPercentage Decimal @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal @map("max_percentage") @db.Decimal(5, 2)
  gradePoint    Decimal @map("grade_point") @db.Decimal(3, 2)
  displayOrder  Int     @default(0) @map("display_order")

  @@map("grade_scales")
}
