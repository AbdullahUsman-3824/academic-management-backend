// Academic Structure Models

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
  INACTIVE
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BatchSemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum StudentAcademicRecordStatus {
  ENROLLED
  PROMOTED
  REPEATED
  ON_PROBATION
  SUSPENDED
  GRADUATED
  DROPPED_OUT
}

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(ACTIVE)

  academicSessions AcademicSession[] @relation("AcademicYearSessions")
  batches          Batch[]

  @@map("academic_years")
}

model AcademicSession {
  id             String                @id @default(uuid()) @db.Uuid
  academicYearId String                @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime              @map("start_date") @db.Date
  endDate        DateTime              @map("end_date") @db.Date
  status         AcademicSessionStatus @default(UPCOMING)
  progressed     Boolean               @default(false)

  academicYear    AcademicYear            @relation("AcademicYearSessions", fields: [academicYearId], references: [id])
  allocations     CourseAllocation[]
  academicRecords StudentAcademicRecord[]

  @@map("academic_sessions")
}

model Batch {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @unique
  entryYearId       String      @map("entry_year_id") @db.Uuid
  programDuration   Int         @default(4) @map("program_duration")
  currentSemesterId String?     @db.Uuid
  sectionCapacity   Int?        @map("section_capacity")
  status            BatchStatus @default(ACTIVE)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime?   @updatedAt @map("updated_at")

  entryYear         AcademicYear            @relation(fields: [entryYearId], references: [id])
  currentSemester   Semester?               @relation("BatchCurrentSemester", fields: [currentSemesterId], references: [id])
  students          Student[]
  sections          Section[]
  courseAssignments BatchCourseAssignment[]
  batchSemesters    BatchSemester[]

  @@index([entryYearId])
  @@map("batches")
}

model Section {
  id        String    @id @default(uuid()) @db.Uuid
  batchId   String    @map("batch_id") @db.Uuid
  name      String
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  batch           Batch                   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  allocations     CourseAllocation[]
  academicRecords StudentAcademicRecord[]

  @@unique([batchId, name])
  @@map("sections")
}

model Semester {
  id         String    @id @default(uuid()) @db.Uuid
  number     Int       @unique
  minCredits Int       @default(12) @map("min_credits")
  maxCredits Int       @default(21) @map("max_credits")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  batchCourseAssignments BatchCourseAssignment[]
  academicRecords        StudentAcademicRecord[]
  batchSemesters         BatchSemester[]
  batchCurrentSemester   Batch[]                 @relation("BatchCurrentSemester")

  @@map("semesters")
}

model BatchSemester {
  id         String              @id @default(uuid()) @db.Uuid
  batchId    String              @map("batch_id") @db.Uuid
  semesterId String              @map("semester_id") @db.Uuid
  status     BatchSemesterStatus @default(UPCOMING)
  lockedAt   DateTime?           @map("locked_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime?           @updatedAt @map("updated_at")

  batch    Batch    @relation(fields: [batchId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@unique([batchId, semesterId])
  @@map("batch_semesters")
}

model StudentAcademicRecord {
  id                            String                      @id @default(uuid()) @db.Uuid
  studentId                     String                      @map("student_id") @db.Uuid
  academicSessionId             String                      @map("academic_session_id") @db.Uuid
  sectionId                     String                      @map("section_id") @db.Uuid
  semesterId                    String                      @map("semester_id") @db.Uuid
  status                        StudentAcademicRecordStatus @default(ENROLLED)
  courseRegistrationFinalizedAt DateTime?                   @map("course_registration_finalized_at")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime?                   @updatedAt @map("updated_at")

  student           Student            @relation(fields: [studentId], references: [id])
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  section           Section            @relation(fields: [sectionId], references: [id])
  semester          Semester           @relation(fields: [semesterId], references: [id])
  courseEnrollments CourseEnrollment[]

  @@unique([studentId, academicSessionId])
  @@map("student_academic_records")
}
