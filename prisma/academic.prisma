// =====================================================
// MODULE 3: ACADEMIC STRUCTURE
// =====================================================

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique // e.g. 2026-27
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("active") // active | inactive | completed

  academicSessions AcademicSession[]

  @@map("academic_years")
}

model AcademicSession {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         String   @default("upcoming")

  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id])
  studentAcademicRecords StudentAcademicRecord[]
  courseAllocations      CourseAllocation[]
  courseResults          StudentCourseResult[]

  @@map("academic_sessions")
}

model Batch {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique // e.g. SP23
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("active") // active | completed | cancelled

  students Student[]

  @@map("batches")
}

model Section {
  id        String    @id @default(uuid()) @db.Uuid
  name      String // e.g. A | B | C
  status    String    @default("active") // active | inactive
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  studentAcademicRecords StudentAcademicRecord[]
  courseAllocations      CourseAllocation[]

  @@map("sections")
}

model StudentAcademicRecord {
  id                String    @id @default(uuid()) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  academicSessionId String    @map("academic_session_id") @db.Uuid
  semesterNumber    Int       @map("semester_number")
  sectionId         String    @map("section_id") @db.Uuid
  status            String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  student           Student            @relation(fields: [studentId], references: [id])
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id])
  section           Section            @relation(fields: [sectionId], references: [id])
  courseEnrollments CourseEnrollment[]

  @@unique([studentId, academicSessionId])
  @@map("student_academic_records")
}
