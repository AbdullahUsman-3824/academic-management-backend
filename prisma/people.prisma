model Student {
  stdRegNumber     String                  @unique @map("std_reg_number")
  firstName        String                  @map("first_name")
  middleName       String?                 @map("middle_name")
  lastName         String?                 @map("last_name")
  email            String?
  dateOfBirth      DateTime?               @map("date_of_birth") @db.Date
  gender           String?
  cnic             String?                 @unique
  profileImageUrl  String?                 @map("profile_image_url")
  phone            String?
  address          String?
  city             String?
  guardianName     String?                 @map("guardian_name")
  guardianRelation String?                 @map("guardian_relation")
  guardianPhone    String?                 @map("guardian_phone")
  guardianCnic     String?                 @map("guardian_cnic")
  admissionDate    DateTime?               @map("admission_date") @db.Date
  status           String                  @default("active")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime?               @updatedAt @map("updated_at")
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @unique @map("user_id") @db.Uuid
  batchId          String                  @map("batch_id") @db.Uuid
  sectionId        String?                 @map("section_id") @db.Uuid
  academicRecords  StudentAcademicRecord[]
  courseResults    StudentCourseResult[]
  marks            StudentMark[]
  batch            Batch                   @relation(fields: [batchId], references: [id])
  section          Section?                @relation(fields: [sectionId], references: [id])
  user             User                    @relation(fields: [userId], references: [id])

  @@index([batchId])
  @@index([status])
  @@index([createdAt])
  @@map("students")
}

model Faculty {
  employeeNumber     String             @unique @map("employee_number")
  firstName          String             @map("first_name")
  middleName         String?            @map("middle_name")
  lastName           String?            @map("last_name")
  email              String?
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date
  gender             String?
  cnic               String?            @unique
  profileImageUrl    String?            @map("profile_image_url")
  phone              String?
  address            String?
  city               String?
  designation        String?
  qualification      String?
  joiningDate        DateTime?          @map("joining_date") @db.Date
  status             String             @default("active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime?          @updatedAt @map("updated_at")
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  createdAssessments Assessment[]       @relation("AssessmentCreatedBy")
  courseAllocations  CourseAllocation[]
  user               User               @relation(fields: [userId], references: [id])
  enteredMarks       StudentMark[]      @relation("MarkEnteredBy")
  updatedMarks       StudentMark[]      @relation("MarkUpdatedBy")

  @@map("faculties")
}
