// =====================================================
// MODULE 2: STUDENT & FACULTY MANAGEMENT
// =====================================================

model Student {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  batchId          Int       @map("batch_id")
  stdRegNumber     String    @unique @map("std_reg_number")

  firstName        String    @map("first_name")
  middleName       String?   @map("middle_name")
  lastName         String?   @map("last_name")
  email            String?
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String? // male | female | other
  cnic             String?   @unique
  profileImageUrl  String?   @map("profile_image_url")

  phone            String?
  address          String?
  city             String?

  guardianName     String?   @map("guardian_name")
  guardianRelation String?   @map("guardian_relation")
  guardianPhone    String?   @map("guardian_phone")
  guardianCnic     String?   @map("guardian_cnic")

  admissionDate    DateTime? @map("admission_date") @db.Date
  status           String    @default("active") // active | inactive | graduated

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user            User                    @relation(fields: [userId], references: [id])
  batch           Batch                   @relation(fields: [batchId], references: [id])
  academicRecords StudentAcademicRecord[]
  marks           StudentMark[]
  courseResults   StudentCourseResult[]

  @@map("students")
}

model Faculty {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  employeeNumber    String    @unique @map("employee_number")

  firstName         String    @map("first_name")
  middleName        String?   @map("middle_name")
  lastName          String?   @map("last_name")
  email             String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  gender            String? // male | female | other
  cnic              String?   @unique
  profileImageUrl   String?   @map("profile_image_url")

  phone             String?
  address           String?
  city              String?

  designation       String?
  qualification     String?
  joiningDate       DateTime? @map("joining_date") @db.Date

  status            String    @default("active") // active | inactive

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id])
  courseAllocations  CourseAllocation[]
  createdAssessments Assessment[]        @relation("AssessmentCreatedBy")
  enteredMarks       StudentMark[]       @relation("MarkEnteredBy")
  updatedMarks       StudentMark[]       @relation("MarkUpdatedBy")

  @@map("faculties")
}
