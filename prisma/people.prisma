// People Models (Students & Faculty)

model Student {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  stdRegNumber     String    @unique @map("std_reg_number")
  batchId          String    @map("batch_id") @db.Uuid
  firstName        String    @map("first_name")
  middleName       String?   @map("middle_name")
  lastName         String?   @map("last_name")
  email            String?
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?
  cnic             String?   @unique
  profileImageUrl  String?   @map("profile_image_url")
  phone            String?
  address          String?
  city             String?
  guardianName     String?   @map("guardian_name")
  guardianRelation String?   @map("guardian_relation")
  guardianPhone    String?   @map("guardian_phone")
  guardianCnic     String?   @map("guardian_cnic")
  admissionDate    DateTime? @map("admission_date") @db.Date
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  user            User                    @relation(fields: [userId], references: [id])
  batch           Batch                   @relation(fields: [batchId], references: [id])
  academicRecords StudentAcademicRecord[]

  @@index([batchId])
  @@index([status])
  @@index([createdAt])
  @@map("students")
}

model Faculty {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  employeeNumber  String    @unique @map("employee_number")
  firstName       String    @map("first_name")
  middleName      String?   @map("middle_name")
  lastName        String?   @map("last_name")
  email           String?
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?
  cnic            String?   @unique
  profileImageUrl String?   @map("profile_image_url")
  phone           String?
  address         String?
  city            String?
  designation     String?
  qualification   String?
  joiningDate     DateTime? @map("joining_date") @db.Date
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  courseAllocations CourseAllocation[]
  assessments       Assessment[]
  marksEntered      StudentMark[]      @relation("EnteredBy")
  marksUpdated      StudentMark[]      @relation("UpdatedBy")

  @@map("faculties")
}
